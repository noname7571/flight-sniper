# Required: SerpApi API key for flight price data
# Sign up at https://serpapi.com (free tier: 250 searches/month)
SERPAPI_API_KEY=your_serpapi_api_key

# Email notification settings (SMTP)
# For Gmail: use an App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Discord notification (optional)
# Create a webhook in your Discord server settings
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Database (optional - defaults to SQLite)
# For production with PostgreSQL (e.g. Neon, Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Vercel Cron secret (optional - for securing cron endpoints)
CRON_SECRET=your_cron_secret

# Server
PORT=3001
