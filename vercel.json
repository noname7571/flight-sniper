{
  "version": 2,
  "buildCommand": "bash vercel-build.sh",
  "routes": [
    { "src": "/api/cron", "dest": "/api/cron" },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
