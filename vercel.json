{
  "version": 2,
  "installCommand": "cd backend && npm install",
  "buildCommand": "bash vercel-build.sh",
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/cron.js": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/cron", "dest": "/api/cron.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
