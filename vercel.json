{
  "version": 2,
  "buildCommand": "cd backend && npm install && npx tsc",
  "outputDirectory": ".",
  "installCommand": "cd backend && npm install",
  "functions": {
    "api/index.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/cron.ts": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.ts" },
    { "src": "/", "dest": "api/index.ts" }
  ]
}
