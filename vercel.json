{
  "version": 2,
  "installCommand": "cd backend && npm install",
  "buildCommand": "cd backend && npx tsc",
  "outputDirectory": ".",
  "functions": {
    "backend/api/index.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "backend/api/cron.ts": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/cron", "dest": "backend/api/cron.ts" },
    { "src": "/api/(.*)", "dest": "backend/api/index.ts" },
    { "src": "/(.*)", "dest": "backend/api/index.ts" }
  ]
}
