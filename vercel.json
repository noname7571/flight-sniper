{
  "version": 2,
  "buildCommand": "cd backend && npm install && npx tsc",
  "outputDirectory": ".",
  "installCommand": "cd backend && npm install",
  "functions": {
    "api/index.ts": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/cron.ts": {
      "memory": 256,
      "maxDuration": 120
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.ts" },
    { "src": "/", "dest": "api/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 * * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
